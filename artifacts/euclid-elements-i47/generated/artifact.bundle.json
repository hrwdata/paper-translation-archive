  "textLayers": {
    "source": {
      "document": "source",
      "segments": [
        {
          "id": "source.seg01",
          "kind": "heading",
          "text": "Proposition 47. In right-angled triangles the square on the side subtending the right angle is equal to the squares on the sides containing the right angle."
        },
        {
          "id": "source.seg02",
          "kind": "construction",
          "text": "Let the square on BA be described, and likewise the squares on AC and BC."
        },
        {
          "id": "source.seg03",
          "kind": "claim",
          "text": "I say that the square on BC is equal to the squares on BA and AC."
        },
        {
          "id": "source.seg04",
          "kind": "support",
          "text": "For parallelograms on the same base and in the same parallels are equal to one another."
        },
        {
          "id": "source.seg05",
          "kind": "conclusion",
          "text": "Therefore the square on the side subtending the right angle is equal to the sum of the two squares on the sides containing the right angle."
        }
      ]
    },
    "translation": {
      "document": "translation",
      "segments": [
        {
          "id": "translation.seg01",
          "kind": "heading",
          "text": "In a right triangle, the square built on the hypotenuse matches the combined area of the squares built on the two legs."
        },
        {
          "id": "translation.seg02",
          "kind": "construction",
          "text": "Construct three squares, one on each side of the triangle, so that the geometric comparison is expressed by explicit figures."
        },
        {
          "id": "translation.seg03",
          "kind": "claim",
          "text": "The target equality is that the area attached to the hypotenuse equals the two leg-squares taken together."
        },
        {
          "id": "translation.seg04",
          "kind": "support",
          "text": "Euclid’s proof route proceeds through area-preserving comparisons of auxiliary figures and then combines equalities."
        },
        {
          "id": "translation.seg05",
          "kind": "conclusion",
          "text": "The final relation is the familiar Pythagorean statement, expressed here as a synchronized English explanation layer."
        }
      ]
    },
    "math": {
      "document": "math",
      "segments": [
        {
          "id": "math.seg01",
          "kind": "statement",
          "text": "Right-triangle square identity",
          "latex": "c^2 = a^2 + b^2"
        },
        {
          "id": "math.seg02",
          "kind": "construction",
          "text": "Define the square operator",
          "latex": "\\operatorname{sq}(n) := n \\cdot n"
        },
        {
          "id": "math.seg03",
          "kind": "claim",
          "text": "State the proposition in symbolic form",
          "latex": "\\operatorname{sq}(c) = \\operatorname{sq}(a) + \\operatorname{sq}(b)"
        },
        {
          "id": "math.seg04",
          "kind": "support",
          "text": "Use symmetry of addition in the final rearrangement",
          "latex": "x + y = y + x"
        },
        {
          "id": "math.seg05",
          "kind": "conclusion",
          "text": "Conclude the proposition statement",
          "latex": "\\operatorname{sq}(a) + \\operatorname{sq}(b) = \\operatorname{sq}(c)"
        }
      ]
    }
  },
