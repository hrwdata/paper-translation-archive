{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alignment-graph.schema.json",
  "type": "object",
  "required": ["version", "anchors", "alignments"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "layer", "target"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "layer": {
            "enum": [
              "artifact_region",
              "source_span",
              "translation_span",
              "math_span",
              "lean_span",
              "theorem_name",
              "hover_metadata",
              "viz_node"
            ]
          },
          "target": { "type": "object" }
        }
      }
    },
    "alignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "members", "display_order", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "members": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "display_order": { "type": "integer", "minimum": 0 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
