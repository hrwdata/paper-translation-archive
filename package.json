{
  "name": "paper-translation-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "validate": "node ./scripts/validate-artifacts.mjs && node ./scripts/check-region-bounds.mjs && node ./scripts/check-alignment-integrity.mjs && node ./scripts/check-toolchain-sync.mjs && node ./scripts/check-snippets-vs-lean.mjs",
    "build:site-data": "node ./scripts/build-lean-metadata.mjs && node ./scripts/build-search-index.mjs && node ./scripts/stage-site-assets.mjs",
    "build": "npm run build:site-data && vite build",
    "preview": "vite preview",
    "check": "npm run validate && npm run typecheck && npm run build",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  }
}
